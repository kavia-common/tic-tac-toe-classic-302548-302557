{
  "name": "tic-tac-toe-classic-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Classic Tic Tac Toe - React frontend",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "HOST=0.0.0.0 PORT=${REACT_APP_PORT:-3000} BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,json,css,md}\" \"public/**/*.{html,css}\"",
    "format:write": "prettier --write \"src/**/*.{js,jsx,json,css,md}\" \"public/**/*.{html,css}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.7.4"
  }
}
